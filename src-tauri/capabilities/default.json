{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "default capability",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "https://*:*"
        },
        {
          "url": "http://localhost:*"
        },
        {
          "url": "http://127.0.0.1:*"
        },
        {
          "url": "http://*.local:*"
        },
        {
          "url": "http://(10\\.\\d+\\.\\d+\\.\\d+):*"
        },
        {
          "url": "http://(192\\.168\\.\\d+\\.\\d+):*"
        },
        {
          "url": "http://(172\\.(?:1[6-9]|2\\d|3[01])\\.\\d+\\.\\d+):*"
        }
      ]
    },
    "dialog:default",
    "fs:default",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-read-text-file",
    "fs:allow-open",
    "fs:allow-write",
    "clipboard-manager:allow-read-text",
    "notification:default",
    "core:event:default",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-read",
    "fs:allow-seek",
    "fs:allow-fstat",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$DOCUMENT/Glean"
        },
        {
          "path": "$DOCUMENT/Glean/**"
        }
      ]
    }
  ]
}