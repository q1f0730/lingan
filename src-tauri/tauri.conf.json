{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Glean",
  "version": "0.1.0",
  "identifier": "com.q1f730.lingan",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "拾穗 Glean",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "shortDescription": "拾穗 Glean：把散落在生活里的灵感一穗一穗捡回来",
    "publisher": "Q1f730",
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "longDescription": "拾穗 Glean 是一个私人灵感收集器：随手拾进打动你的音乐、电影、图片、文案和想法，再把相距很远的两穗嫁接成新的创意。数据只保存在本机。"
  }
}