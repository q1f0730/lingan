{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lingan",
  "version": "0.1.0",
  "identifier": "com.q1f730.lingan",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "灵感暗房 Lingan",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "shortDescription": "灵感暗房：私人灵感收集与显影",
    "publisher": "Q1f730",
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}