{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Glean",
  "version": "0.39.0",
  "identifier": "com.q1f730.lingan",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "拾穗 Glean",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 360,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data:",
        "media-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug",
      "minSdkVersion": 28
    },
    "shortDescription": "拾穗 Glean：把散落在生活里的灵感一穗一穗捡回来",
    "publisher": "Q1f730",
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "longDescription": "拾穗 Glean 是一个私人灵感收集器：随手拾进打动你的音乐、电影、图片、文案和想法，再把相距很远的两穗嫁接成新的创意。数据只保存在本机。",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBNzhDNEFGQTcxM0IzMjIKUldRaXN4T25yOFI0ZXJBZDBkS3pIdHIreksza3VscENDMythMmdhSjRzR2I3ZEgvc1NjNjI5NTkK",
      "endpoints": [
        "https://github.com/q1f0730/lingan/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}